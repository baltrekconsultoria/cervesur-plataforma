# Finales de línea y binarios del frontend (UX-06C.0). Solo aplica a frontend/: no modifica el backend existente.
frontend/** text=auto eol=lf
frontend/**/*.png binary
frontend/**/*.jpg binary
frontend/**/*.ico binary

# Instalación por túnel SSH (UX-07D.1B): los scripts y configuraciones se ejecutan en Linux; siempre LF.
deploy/tunel-ssh/** text eol=lf
deploy/apache/*.conf text eol=lf
deploy/apache/*.example text eol=lf
