# Copy this file to backend/.env only for a local isolated environment.
# Do not use production values and do not commit backend/.env.
DB_HOST=localhost
DB_NAME=cervesur_local
DB_USER=cervesur_local_user
DB_PASS=replace-with-a-local-password
DB_CHARSET=utf8mb4

# Generate a unique local value; this placeholder is intentionally invalid.
JWT_SECRET=replace-with-a-unique-local-jwt-secret
JWT_EXPIRATION=3600
