-- UX-08H · Cuenta de escritura de PRIVILEGIOS MÍNIMOS para el modo «admin_escritura» (fase 2).
--
-- PLANTILLA. NO SE EJECUTA EN NINGÚN SERVIDOR REAL sin autorización expresa, respaldo y revisión del responsable.
-- Se prueba únicamente en MySQL desechable (tests/isolated/setup_admin_write.php), que sustituye {DB}, {USER}, {HOST} y {PASS}.
-- NO es la cuenta `cervesur_portalbi_admin` ni la de Flutter: es una cuenta NUEVA, solo para esta instancia.
--
-- Diferencias con UX-08E (que concedía SELECT sobre toda la base):
--   * SELECT POR COLUMNAS: sin `user.password` y sin `empresa.powerbi_*`. La aplicación jamás las lee en este modo.
--   * INSERT por columnas en `empresa`: sin `powerbi_*`.
--   * Sin DELETE, DDL, TRIGGER, GRANT OPTION, DROP, TRUNCATE, ALTER ni FILE/SUPER: las bajas son lógicas (`activo` / `is_active`).
--   * `audit_log`: SOLO SELECT e INSERT. La cuenta no puede modificar ni borrar el historial (además hay triggers de inmutabilidad, UX-08B.2).
--   * `reporte.enlace`: se lee solo para el visor autorizado (misma política que el piloto) y se escribe solo en alta/edición.

CREATE USER IF NOT EXISTS '{USER}'@'{HOST}' IDENTIFIED BY '{PASS}';

-- Lecturas (por columnas)
GRANT SELECT (id, username, email, first_name, last_name, phone, avatar, role, is_active, session_version, last_login, created_at, updated_at)
    ON `{DB}`.`user` TO '{USER}'@'{HOST}';
GRANT SELECT (id, nombre, razon_social, ruc, email, telefono, website, direccion, ciudad, pais, logo, contacto_principal,
              created_by, updated_by, created_at, updated_at, activo)
    ON `{DB}`.`empresa` TO '{USER}'@'{HOST}';
GRANT SELECT (id, nombre, descripcion, enlace, grupo_id, reporte_id, created_by, updated_by, created_at, updated_at, activo)
    ON `{DB}`.`reporte` TO '{USER}'@'{HOST}';
GRANT SELECT ON `{DB}`.`empresa_usuario`      TO '{USER}'@'{HOST}';
GRANT SELECT ON `{DB}`.`empresa_reporte`      TO '{USER}'@'{HOST}';
GRANT SELECT ON `{DB}`.`user_empresa_reporte` TO '{USER}'@'{HOST}';
GRANT SELECT ON `{DB}`.`audit_log`            TO '{USER}'@'{HOST}';

-- Altas
GRANT INSERT (first_name, last_name, username, email, phone, password, role, is_active, session_version, created_at, updated_at)
    ON `{DB}`.`user` TO '{USER}'@'{HOST}';
GRANT INSERT (nombre, razon_social, ruc, email, telefono, website, direccion, ciudad, pais, logo, contacto_principal, created_by)
    ON `{DB}`.`empresa` TO '{USER}'@'{HOST}';
GRANT INSERT (nombre, descripcion, enlace, grupo_id, reporte_id, created_by)
    ON `{DB}`.`reporte` TO '{USER}'@'{HOST}';
GRANT INSERT ON `{DB}`.`empresa_usuario`      TO '{USER}'@'{HOST}';
GRANT INSERT ON `{DB}`.`empresa_reporte`      TO '{USER}'@'{HOST}';
GRANT INSERT ON `{DB}`.`user_empresa_reporte` TO '{USER}'@'{HOST}';
GRANT INSERT ON `{DB}`.`audit_log`            TO '{USER}'@'{HOST}';

-- Modificaciones: solo las columnas que la aplicación cambia
GRANT UPDATE (first_name, last_name, phone, email, role, is_active, session_version, last_login, password, avatar, updated_at)
    ON `{DB}`.`user` TO '{USER}'@'{HOST}';
GRANT UPDATE (nombre, razon_social, ruc, email, telefono, website, direccion, ciudad, pais, logo, contacto_principal, activo, updated_by)
    ON `{DB}`.`empresa` TO '{USER}'@'{HOST}';
GRANT UPDATE (nombre, descripcion, enlace, grupo_id, reporte_id, activo, updated_by)
    ON `{DB}`.`reporte` TO '{USER}'@'{HOST}';
GRANT UPDATE (empresa_id, user_id, notas, activo, updated_by)
    ON `{DB}`.`empresa_usuario` TO '{USER}'@'{HOST}';
GRANT UPDATE (empresa_id, reporte_id, notas, activo, updated_by, updated_at)
    ON `{DB}`.`empresa_reporte` TO '{USER}'@'{HOST}';
GRANT UPDATE (user_id, empresa_reporte_id, notas, activo, updated_by)
    ON `{DB}`.`user_empresa_reporte` TO '{USER}'@'{HOST}';

