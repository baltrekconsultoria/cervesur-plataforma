-- P5-R: privilegio mínimo, únicamente cambio de contraseña de usuario.
-- NO incluye UPDATE(role), UPDATE(email), SELECT(password), ni permisos globales.
-- Exige UX-08I no-sensibles instalado, respaldo y autorización DBA explícita.
-- Marcadores de despliegue: {DB}, {USER}, {HOST}; DDL NO transaccional.
GRANT UPDATE (password) ON `{DB}`.`user` TO '{USER}'@'{HOST}';
