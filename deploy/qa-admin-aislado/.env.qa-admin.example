# EJEMPLO (sin secretos) del .env que scripts/pasos-instalacion.sh genera en /opt/cervesur-react-admin-qa/backend/.env (modo 640, root:www-data).
# NO lo copie ni lo rellene a mano: el instalador lo escribe con valores generados en el servidor. Este archivo solo documenta su forma.
#
DB_HOST=127.0.0.1
DB_NAME=cervesur_qa_admin
DB_USER=cervesur_qa_admin_w
# DB_PASS=<se genera en el servidor (política MySQL MEDIUM); jamás se guarda en el paquete ni se imprime>
DB_CHARSET=utf8mb4
# JWT_SECRET=<se genera en el servidor (64 hex); propio de este entorno>
JWT_EXPIRATION=3600
#
# Auditoría obligatoria: si audit_log falla, la escritura se revierte.
AUDIT_LOG_MODE=required
# Vistas mínimas por defecto en las listas (sin enlace de Power BI).
REACT_STRICT_VIEWS=1
# ESCRITURAS ADMINISTRATIVAS: SOLO PARA ESTE ENTORNO DE QA. Debe permanecer APAGADO (ausente o distinto de 1) en los portales publicados 443/8443.
USER_ADMIN_WRITES=1
# Informes que el administrador puede abrir en el visor. 31 = informe SINTÉTICO que hace de DB031 (la base sintética no tiene DB031).
# El id real (72) solo se usa en el piloto real, tras aprobación expresa del responsable.
ADMIN_VIEWER_ALLOWED_REPORT_IDS=31
