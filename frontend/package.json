{
  "name": "cervesur-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Frontend definitivo del portal Corporación Cervesur (UX-05.1). Solo datos sintéticos.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "dev:qa": "node scripts/ensure-qa-env.mjs && vite --mode qa",
    "build:qa": "node scripts/ensure-qa-env.mjs && tsc --noEmit && vite build --mode qa --outDir dist-qa",
    "preview:qa": "vite preview --mode qa --outDir dist-qa --port 4175",
    "build:production": "node scripts/build-production.mjs",
    "build:pilot": "node scripts/build-production.mjs --pilot",
    "build:pilot-usuarios": "node scripts/build-production.mjs --pilot-usuarios",
    "build:pilot-admin": "node scripts/build-production.mjs --pilot-admin",
    "build:admin-write": "node scripts/build-production.mjs --admin-write",
    "verify:admin-write": "node scripts/verify-production-build.mjs dist-admin-write",
    "verify:pilot-admin": "node scripts/verify-production-build.mjs dist-pilot-admin",
    "verify:pilot-usuarios": "node scripts/verify-production-build.mjs dist-pilot-usuarios",
    "verify:pilot": "node scripts/verify-production-build.mjs dist-pilot",
    "verify:production": "node scripts/verify-production-build.mjs dist-production",
    "preview:production": "vite preview --mode production --outDir dist-production --host 127.0.0.1 --port 4178 --strictPort",
    "build:qa:real": "node scripts/build-qa-real.mjs",
    "preview:qa:real": "vite preview --mode qa --outDir dist-qa-real --port 4177",
    "qa:up": "node qa/backend.mjs up",
    "qa:down": "node qa/backend.mjs down",
    "qa:status": "node qa/backend.mjs status",
    "qa:backend-ci": "node qa/backend.mjs ci",
    "test:contract": "node qa/contract.mjs",
    "test:e2e:qa": "node e2e/run-qa.mjs",
    "test:e2e:layout": "node e2e/run-layout.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
